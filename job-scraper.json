  "nodes": [
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"platform\": {\n      \"type\": \"string\",\n      \"enum\": [\"LinkedIn\", \"JobStreet\", \"Indeed\", \"OLJ PH\", \"Generic\"],\n      \"description\": \"The website where the job was posted. Use 'Generic' if the website is not LinkedIn, JobStreet, Indeed, or OLJ PH.\"\n    },\n    \"company_name\": {\n      \"type\": \"string\",\n      \"description\": \"The extracted name of the hiring company. Use 'Undisclosed' if missing.\"\n    },\n    \"job_title\": {\n      \"type\": \"string\",\n      \"description\": \"The official job or role title.\"\n    },\n    \"cleaned_job_description\": {\n      \"type\": \"string\",\n      \"description\": \"A single continuous clean string summarizing core responsibilities and tech stack rules. Strictly no newlines or bullet points.\"\n    },\n    \"search_keywords\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"An array containing exactly 5 relevant search keywords or phrases.\"\n    }\n  },\n  \"required\": [\"platform\", \"company_name\", \"job_title\", \"cleaned_job_description\", \"search_keywords\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
