    {
      "parameters": {
        "jsCode": "// Safe access to the Gemini stringified text payload\nconst rawText = $input.item.json.content?.parts?.[0]?.text || \"{}\";\n\n// Parse string into an object\nlet receiptData = {};\ntry {\n  receiptData = JSON.parse(rawText);\n} catch (e) {\n  // Gracefully handle unparseable text chunks\n}\n\n// Gather upstream data dynamically via cross-node lookup\nconst photoPicker = $('Photo Picker').item.json;\n\n// Validate reading accuracy\nconst hasMerchant = receiptData.merchant_name && receiptData.merchant_name.toLowerCase() !== 'unknown';\nconst hasAmount = receiptData.total_amount && parseFloat(receiptData.total_amount) > 0;\nconst isValid = !!(hasMerchant && hasAmount);\n\n// Output the schema matching target parameters\nreturn {\n  json: {\n    chatId: photoPicker.chatId,\n    messageId: photoPicker.messageId,\n    submissionTimestamp: photoPicker.submissionTimestamp,\n    submissionDate: photoPicker.submissionDate,\n    merchant: receiptData.merchant_name || \"Unknown Merchant\",\n    amount: parseFloat(receiptData.total_amount) || 0,\n    currency: \"USD\",\n    date: receiptData.date || photoPicker.submissionDate,\n    isValid: isValid\n  }\n};"
      },
