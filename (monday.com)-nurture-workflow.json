      "parameters": {
        "promptType": "define",
        "text": "=Write a follow-up email (Day 3) for a MEDIUM lead.\n\nLead details:\nName: {{ $json.column_values[0].text }}\nProblem: {{ $json.column_values[12].text }}\n\nGoal:\nProvide a helpful insight or tip.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are a consultant providing value without selling.\n\nStyle:\n- Helpful\n- Insightful\n- Practical\n\nGoal:\nGive a useful tip or idea related to their problem.\n\nNo hard selling.\n\nRules:\n- subject must be a plain string (NOT an object)\n- body must be a plain string (NOT an object)\n- Do NOT wrap values inside { \"text\": ... }\n- Do NOT return nested objects\n- Do NOT include explanations\n- Do NOT use markdown or backticks\n\nOutput JSON only."
            }
          ]
        },
        "batching": {}
      },
