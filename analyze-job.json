    {
      "parameters": {
        "jsCode": "const url = $('Normalize Data').first().json.url;\nlet actorId;\nif (url.includes('linkedin.com')) actorId = 'bebity~linkedin-jobs-scraper';\nelse if (url.includes('indeed.com')) actorId = 'misceres~indeed-scraper';\nelse if (url.includes('jobstreet.com')) actorId = 'blackfalcondata~jobstreet-scraper';\nelse if (url.includes('onlinejobs.ph')) actorId = 'inatanli~onlinejobs-ph-scraper';\nelse throw new Error(`No actor mapped for URL: ${url}`);\n\nreturn { json: { actorId, body: { startUrls: [url] } } };"
      },
