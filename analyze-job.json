    {
      "parameters": {
        "jsCode": "const raw = $json.output || $json;\n\nconst recommendationMap = {\n  APPLY: \"apply\",\n  MAYBE: \"maybe\",\n  SKIP: \"skip\",\n};\n\nconst recommendation =\n  String(raw.recommendation || \"MAYBE\").toUpperCase();\n\nconst verdict =\n  recommendationMap[recommendation] || \"maybe\";\n\nconst payload = {\n  endpoint: \"analyze-job\",\n\n  jobId: $json.jobId || $json.id || null,\n\n  data: {\n    summary: {\n      company: raw.company || \"\",\n      companyBlurb: raw.companyBlurb || \"\",\n      role: raw.role || \"\",\n      seniority: raw.seniority || \"\",\n      salary: raw.salary || \"\",\n      salaryConfidence: raw.salaryConfidence || \"\",\n      location: raw.location || \"\",\n      workMode: raw.workMode || \"\",\n      postedAt: raw.postedAt || \"\",\n      employmentType: raw.employmentType || \"\",\n      team: raw.team || \"\",\n    },\n\n    responsibilities: Array.isArray(raw.responsibilities)\n      ? raw.responsibilities\n      : [],\n\n    requirements: {\n      must: Array.isArray(raw.requirements?.must)\n        ? raw.requirements.must\n        : [],\n\n      nice: Array.isArray(raw.requirements?.nice)\n        ? raw.requirements.nice\n        : [],\n    },\n\n    scores: {\n      overall: Number(raw.scores?.overall ?? 0),\n      technical: Number(raw.scores?.technical ?? 0),\n      portfolio: Number(raw.scores?.portfolio ?? 0),\n      experience: Number(raw.scores?.experience ?? 0),\n      communication: Number(raw.scores?.communication ?? 0),\n    },\n\n    recommendation: {\n      verdict,\n\n      headline:\n        raw.recommendation_headline ||\n        \"Review this role\",\n\n      reasons: Array.isArray(raw.reasons)\n        ? raw.reasons\n        : [],\n    },\n\n    strengths: Array.isArray(raw.strengths)\n      ? raw.strengths.map((item) => ({\n          title:\n            typeof item === \"string\"\n              ? item\n              : item.title || \"\",\n\n          evidence:\n            typeof item === \"string\"\n              ? \"\"\n              : item.evidence || \"\",\n        }))\n      : [],\n\n    gaps: Array.isArray(raw.gaps)\n      ? raw.gaps.map((item) => ({\n          skill:\n            typeof item === \"string\"\n              ? item\n              : item.skill || \"\",\n\n          priority:\n            typeof item === \"string\"\n              ? \"medium\"\n              : String(item.priority || \"medium\").toLowerCase(),\n\n          learningTime:\n            typeof item === \"string\"\n              ? \"\"\n              : item.learningTime || \"\",\n\n          why:\n            typeof item === \"string\"\n              ? \"\"\n              : item.why || \"\",\n        }))\n      : [],\n\n    atsKeywords: Array.isArray(raw.ats_keywords)\n      ? raw.ats_keywords.map((item) => ({\n          term: String(item),\n          hits: 1,\n          inResume: false,\n        }))\n      : [],\n  },\n};\n\nreturn [{ json: payload }];"
      },
