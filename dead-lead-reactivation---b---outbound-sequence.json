    {
      "parameters": {
        "jsCode": "const BATCH_LIMIT = 20; // keep sends small while testing\n\n// Only leads that are (a) flagged ready by Workflow A and (b) have actually\n// opted in to EMAIL specifically. A lead could be 'ready_for_outreach' with\n// SMS-only consent — since we're email-only now, those are correctly\n// skipped here rather than emailed without consent for that channel.\nconst ready = items.filter(item =>\n  item.json['Status'] === 'ready_for_outreach' &&\n  item.json['Email Opt-In'] === 'Yes'\n);\nreturn ready.slice(0, BATCH_LIMIT);"
      },
      "id": "007721f4-acf7-4ec5-99ef-0ab48f14da2c",
      "name": "Filter Ready & Cap Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pull the original lead details by sequence position\nconst originalLeads = $('Filter Ready & Cap Batch').all().map(i => i.json);\n\nreturn items.map((item, idx) => {\n  const lead = originalLeads[idx] || {};\n  \n  // Extract the cleanly parsed fields directly from the LLM output object\n  const outputData = item.json?.output || {};\n\n  return {\n    json: {\n      ...lead, // Keeps your row ID, email address, etc.\n      emailSubject: outputData.subject || 'Following up on your project',\n      emailBody: outputData.body || ''\n    }\n  };\n});\n"
      },
