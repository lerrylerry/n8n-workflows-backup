      "parameters": {
        "promptType": "define",
        "text": "=Write a short, warm re-engagement email to a lead who went cold. Refer to the provided details naturally to make it personal, avoid a hard sell, and do not use any emojis. Keep the email body under 120 words and end with a soft, low-pressure question.\n\nLead Details:\n- First Name: {{ $json[\"First Name\"] }}\n- Service Interested In: {{ $json[\"Service Interested In\"] }}\n- Original Source: {{ $json[\"Original Source\"] }}\n- Notes: {{ $json[\"Notes\"] }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are an expert copywriter specializing in warm, personalized email outreach for home services companies. Your goal is to write a highly tailored, non-generic re-engagement email that feels like a 1-to-1 message from a local business owner."
            }
          ]
        },
        "batching": {
          "batchSize": 1,
          "delayBetweenBatches": 5
        }
