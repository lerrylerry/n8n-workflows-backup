      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "de594445-6be0-4559-82f2-032aee1f9ba6",
              "name": "system_prompt",
              "value": "=You are an expert pharmaceutical inventory optimization AI. Your job is to format near-expiry inventory data into clear, highly professional communications based on the active data bucket.\n\nCURRENT ACTIVE BUCKET: medical_mission\n\nSTRICT OUTPUT GENERATION RULES:\n1. FINANCE MEMO GREETING: Write exactly one professional sentence addressing the finance team, informing them that these products are available for medical mission donation.\n2. TOTAL PRODUCT VALUE FORMATTING: Calculate or display the total financial value of the inventory items. Always display this value with exactly two decimal places, forcing trailing zeros if the value is whole (e.g., 3485.00 or 3485.50). Do not include currency symbols or thousands separators.\n3. ESTIMATED TAX SAVINGS FORMATTING: Display the calculated tax savings. Always format this value with exactly two decimal places, forcing trailing zeros if whole (e.g., 680.00 or 680.04). Do not include currency symbols or thousands separators.\n4. TAX PERCENTAGE FORMATTING: Display the tax shield rate strictly as a whole number followed immediately by a percentage sign (e.g., 25%).",
              "type": "string"
            },
            {
              "id": "812ecaf9-767d-4198-ab84-7b724fe26490",
              "name": "user_prompt",
              "value": "=Please process the following medical mission inventory data payload:\n\nActive Category: medical_mission\nEstimated Tax Savings from Payload: ₱{{ $json.estimatedTaxSavings }}\nRaw Product Data Stream:\n\"{{ $('Route based on category').item.json.productList }}\"\n\nApply the specific medical mission formatting rules and return the matching structured JSON block.",
              "type": "string"
            },
            {
              "id": "085e17c0-eb00-408e-8c53-6376d635b03f",
              "name": "output_parser",
              "value": "={\n  \"$schema\": \"http://json-schema.org\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"bucket_processed\": {\n      \"type\": \"string\",\n      \"enum\": [\"franchisee_permission\", \"medical_mission\"],\n      \"description\": \"The name of the inventory lane processed.\"\n    },\n    \"franchisee_email\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"subject\": { \"type\": \"string\" },\n        \"greeting_sentence\": { \"type\": \"string\" },\n        \"item_bullet_list\": { \"type\": \"string\" },\n        \"product_count\": { \"type\": \"integer\" },\n        \"estimated_total_price\": { \"type\": \"string\" }\n      }\n    },\n    \"tax_mission_report\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"finance_memo_greeting\": {\n          \"type\": \"string\",\n          \"description\": \"Exactly one sentence addressing the finance team regarding product availability for medical mission donation.\"\n        },\n        \"total_product_value\": {\n          \"type\": \"string\",\n          \"description\": \"The total value of products. Must strictly use two decimal places, including .00 for whole numbers.\"\n        },\n        \"estimated_tax_savings\": {\n          \"type\": \"string\",\n          \"description\": \"The corporate tax savings amount under Section 34(H). Must strictly use two decimal places, including .00 for whole numbers.\"\n        },\n        \"tax_percentage\": {\n          \"type\": \"string\",\n          \"description\": \"The tax shield percentage applied, formatted exactly as a number and percentage sign (e.g., 25%).\"\n        }\n      },\n      \"required\": [\"finance_memo_greeting\", \"total_product_value\", \"estimated_tax_savings\", \"tax_percentage\"]\n    }\n  },\n  \"required\": [\"bucket_processed\"]\n}\n",
              "type": "string"
            }
          ]
        },
