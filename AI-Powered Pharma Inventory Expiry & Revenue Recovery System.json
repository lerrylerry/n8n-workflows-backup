    {
      "parameters": {
        "jsCode": "let franchiseeItems = [];\nlet flashSaleItems = [];\nlet medicalMissionItems = [];\nlet totalTaxSavings = 0;\nlet rowDetails = [];\n\nconst today = new Date();\nconst weekLabel = 'Wk' + Math.ceil(today.getDate() / 7);\nconst dateProcessed = today.toISOString().slice(0, 10);\n\nfor (const item of items) {\n  // Skip anything already actioned in a previous run.\n  const status = (item.json['STATUS'] || '').toString().trim();\n  if (status !== '') continue;\n\n  // Read the pre-calculated column instead of re-deriving it from EXP text.\n  const monthsRemaining = Number(item.json['MONTHS REMAINING']);\n  if (isNaN(monthsRemaining)) continue;\n\n  const barcode = item.json['BARCODE'] || '';\n  const description = item.json['DESCRIPTION'] || '';\n  const qty = item.json['QTY'] || 0;\n  const exp = item.json['EXP'] || '';\n  const price = item.json['PRICE'] || 0;\n  const totalPrice = Number(item.json['TOTAL PRICE']) || 0;\n  \n  // EDIT: Extract n8n's native unique sheet row identifier \n  const rowNumber = item.json['row_number'];\n\n  // Safe check for blank/spacer cells at the bottom of the spreadsheet\n  if (!description || description.trim() === \"\") continue;\n\n  let bucket = null;\n  const rawItemString = `Barcode: ${barcode} | Product: ${description} | Qty: ${qty} | Price: ${price} | Expiry: ${exp}`;\n\n  if (monthsRemaining >= 6 && monthsRemaining <= 12) {\n    bucket = 'franchisee_permission';\n    franchiseeItems.push(rawItemString);\n  } else if (monthsRemaining >= 3 && monthsRemaining < 6) {\n    bucket = 'flash_sale';\n    flashSaleItems.push(rawItemString);\n  } else if (monthsRemaining >= 0 && monthsRemaining < 3) {\n    bucket = 'medical_mission';\n    totalTaxSavings += totalPrice * 0.25;\n    medicalMissionItems.push(`Product: ${description} | Total Cost Value: ${totalPrice}`);\n  } else {\n    continue; // already expired or further than 12 months out\n  }\n\n  const statusText = `${bucket} (${weekLabel})`;\n\n  // Single clean dataset mapping layout\n  rowDetails.push({\n    json: {\n      type: 'row_detail',\n      bucket: bucket,\n      'ROW_NUMBER': rowNumber, // EDITED: Added the unique key to the update payload\n      'BARCODE': barcode,\n      'DESCRIPTION': description,\n      'QTY': qty,\n      'EXP': exp,\n      'PRICE': price,\n      'TOTAL_PRICE': totalPrice,\n      'STATUS': statusText,\n      'DATE_PROCESSED': dateProcessed\n    }\n  });\n}\n\nconst summaries = [];\nif (franchiseeItems.length) {\n  summaries.push({ json: { type: 'bucket_summary', bucket: 'franchisee_permission', productList: franchiseeItems.join('\\n'), totalItems: franchiseeItems.length } });\n}\nif (flashSaleItems.length) {\n  summaries.push({ json: { type: 'bucket_summary', bucket: 'flash_sale', productList: flashSaleItems.join('\\n'), totalItems: flashSaleItems.length } });\n}\nif (medicalMissionItems.length) {\n  summaries.push({ json: { type: 'bucket_summary', bucket: 'medical_mission', productList: medicalMissionItems.join('\\n'), totalItems: medicalMissionItems.length, estimatedTaxSavings: totalTaxSavings.toFixed(2) } });\n}\n\nif (summaries.length === 0 && rowDetails.length === 0) {\n  return [{ json: { type: 'skip', bucket: 'skip' } }];\n}\n\nreturn [...summaries, ...rowDetails];"
      },
