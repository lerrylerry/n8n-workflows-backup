    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "de594445-6be0-4559-82f2-032aee1f9ba6",
              "name": "system_prompt",
              "value": "=CURRENT ACTIVE BUCKET: flash_sale\n\nSTRICT OUTPUT GENERATION RULES:\n1. FLASH SALE GREETING: Write exactly one high-energy, exciting attention-grabbing header sentence announcing the flash sale to customers or creators.\n2. ITEM LIST FORMAT: Present items as a clean bulleted list. Each item line must strictly use this layout: \"- [Medicine Name] - [Count] - [Flash Price]\"\n3. PRICE FORMATTING RULE: For item flash prices, display the value as a whole number if the decimal is 0 (e.g., 20). If the decimal is a non-zero value, display it with exactly two decimal places (e.g., 22.50). Never use trailing \".00\" for whole numbers.\n4. HASHTAGS: Provide a short string containing exactly 3 trending local pharmacy/sale hashtags at the very bottom.",
              "type": "string"
            },
            {
              "id": "dda3f14f-7aea-4081-a31f-88eab54eb1e7",
              "name": "user_prompt",
              "value": "=Please process the following flash sale inventory data payload:\n\nActive Category: flash_sale\nRaw Product Data Stream:\n\"{{ $('Route based on category').item.json.productList }}\"\n\nApply the strict flash sale formatting rules and return the matching structured JSON block.",
              "type": "string"
            },
            {
              "id": "52c7f5d5-8d7a-4e1d-8338-1ac3e32ac7c3",
              "name": "output_parser",
              "value": "={\n  \"$schema\": \"http://json-schema.org\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"bucket_processed\": {\n      \"type\": \"string\",\n      \"enum\": [\"flash_sale\", \"medical_mission\", \"franchisee_permission\"],\n      \"description\": \"The name of the inventory lane processed by the workflow.\"\n    },\n    \"flash_sale\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"flash_sale_greeting\": {\n          \"type\": \"string\",\n          \"description\": \"Exactly one high-energy sentence announcing the flash sale blast.\"\n        },\n        \"item_bullet_list\": {\n          \"type\": \"string\",\n          \"description\": \"The structured bulleted list matching: - [Medicine] - [Count] - [Flash Price]\"\n        },\n        \"social_hashtags\": {\n          \"type\": \"string\",\n          \"description\": \"3 trending pharmacy/retail hashtags grouped together.\"\n        }\n      },\n      \"required\": [\"flash_sale_greeting\", \"item_bullet_list\", \"social_hashtags\"]\n    },\n    \"tax_mission_report\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"finance_memo_greeting\": {\n          \"type\": \"string\",\n          \"description\": \"Exactly one sentence addressing the finance team regarding product availability for medical mission donation.\"\n        },\n        \"total_product_value\": {\n          \"type\": \"string\",\n          \"description\": \"The total value of products. Must strictly use two decimal places, including .00 for whole numbers.\"\n        },\n        \"estimated_tax_savings\": {\n          \"type\": \"string\",\n          \"description\": \"The corporate tax savings amount under Section 34(H). Must strictly use two decimal places, including .00 for whole numbers.\"\n        },\n        \"tax_percentage\": {\n          \"type\": \"string\",\n          \"description\": \"The tax shield percentage applied, formatted exactly as a number and percentage sign (e.g., 25%).\"\n        }\n      },\n      \"required\": [\"finance_memo_greeting\", \"total_product_value\", \"estimated_tax_savings\", \"tax_percentage\"]\n    },\n    \"franchisee_permission\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"franchisee_greeting\": {\n          \"type\": \"string\",\n          \"description\": \"Exactly one polite sentence offering the near-expiry items to the franchisee.\"\n        },\n        \"item_bullet_list\": {\n          \"type\": \"string\",\n          \"description\": \"The structured bulleted list matching: - [Medicine] - [Count] - [Price] - [Expiry]\"\n        }\n      },\n      \"required\": [\"franchisee_greeting\", \"item_bullet_list\"]\n    }\n  },\n  \"required\": [\"bucket_processed\"]\n}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
