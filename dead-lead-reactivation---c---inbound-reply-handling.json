    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const msg = item.json;\n  const fromRaw = msg.from || (msg.headers && msg.headers.from) || '';\n  const emailMatch = String(fromRaw).match(/<(.+?)>/);\n  const fromEmail = (emailMatch ? emailMatch[1] : fromRaw).toLowerCase().trim();\n\n  return {\n    json: {\n      fromEmail,\n      subject: msg.subject || '',\n      inboundMessage: msg.text || msg.snippet || '',\n      gmailMessageId: msg.id || ''\n    }\n  };\n});"
      },
      "id": "5fcedb5a-a47d-4973-9a43-3a0d87a6b3bf",
