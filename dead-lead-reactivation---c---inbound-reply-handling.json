      "id": "eb72063f-1d70-4c6c-8bd4-55983330b948",
      "name": "Find Lead by Email",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -2848,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const inbound = $('Normalize Inbound Payload').first().json;\nreturn items.map(item => ({\n  json: {\n    ...item.json,\n    fromEmail: inbound.fromEmail,\n    subject: inbound.subject,\n    inboundMessage: inbound.inboundMessage,\n    gmailMessageId: inbound.gmailMessageId\n  }\n}));"
      },
      "id": "dde9a2b4-90f8-4eb8-b9b9-f19d3ed70a33",
      "name": "Merge Lead + Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2608,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-5', max_tokens: 250, messages: [ { role: 'user', content: `You are classifying an inbound EMAIL reply from a home services lead who was contacted as part of a dead-lead reactivation campaign. Lead's original service interest: {{ $json['Service Interested In'] }}. Email subject: \\\"{{ $json.subject }}\\\". Email body they just sent: \\\"{{ $json.inboundMessage }}\\\". Classify the intent as exactly one of: STOP, interested, not_interested, question. STOP = any opt-out language (unsubscribe, remove me, stop emailing me, do not contact). interested = wants to move forward, book a call, get pricing, or continue the conversation positively. not_interested = polite or firm decline, no further interest. question = asking for info without a clear opt-in/out signal yet. If intent is 'question', also draft a short, helpful reply_text (under 120 words, no emojis, plain text, no signature needed). For all other intents, reply_text should be an empty string. Return ONLY valid JSON in this exact shape, nothing else: {\\\"intent\\\": \\\"...\\\", \\\"reply_text\\\": \\\"...\\\"}` } ] }) }}",
        "options": {}
      },
      "id": "92dd9e37-26d3-4446-b3f8-3444c6265b9b",
      "name": "Classify Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -2368,
        304
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Q5OG1XyWLgZn0fe9",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Same fix as Workflow B: after the HTTP Request node, $json is Claude's raw\n// API response, not the lead+message data. Pull the original back in by\n// position from the node right before the HTTP call.\nconst originalItems = $('Merge Lead + Message').all().map(i => i.json);\n\nreturn items.map((item, idx) => {\n  const original = originalItems[idx] || {};\n  const raw = item.json?.content?.[0]?.text || '{}';\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n\n  let parsed;\n  try {\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    parsed = { intent: 'question', reply_text: '' };\n  }\n\n  return {\n    json: {\n      ...original,\n      intent: parsed.intent,\n      reply_text: parsed.reply_text || ''\n    }\n  };\n});"
      },
      "id": "a6ffd570-df62-48a6-bfde-2e54aac21f2b",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.code",
