    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a tailored resume for this job.\n\nJOB TITLE:\n{{ $json.job_title }}\n\nCOMPANY:\n{{ $json.company }}\n\nJOB DESCRIPTION:\n{{ $json.job_description }}\n\nJOB ANALYSIS:\n{{ JSON.stringify($json.job_analysis) }}\n\nCANDIDATE CAREER PROFILE:\n{{ JSON.stringify($json.career_profile) }}\n\nUse only verified information from the Career Profile.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are LerrieGPT's Resume Tailoring Engine.\n\nCreate a tailored resume using the candidate's Career Profile and the target job.\n\nRules:\n- The Career Profile is the source of truth.\n- Never invent experience, skills, employers, metrics, or achievements.\n- Never add a qualification only because it appears in the job description.\n- Do not turn projects, education, or learning into professional experience.\n- Select the most relevant candidate information for this job.\n- Use ATS keywords only when supported by the candidate's actual background.\n- Keep the resume concise and professional.\n- Preserve factual accuracy.\n\nReturn only the structured output requested by the system."
            }
          ]
        },
        "batching": {}
      },
