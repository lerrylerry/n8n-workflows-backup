    {
      "parameters": {
        "jsCode": "const binaries = $('Get Attachments').item.binary || {};\nconst out = [];\n\n// Loop through and separate each email attachment\nfor (const key of Object.keys(binaries)) {\n  const bin = binaries[key];\n  \n  // Clean illegal characters from filename\n  let filename = bin.fileName || `${key}.bin`;\n  filename = filename.replace(/[\\\\/:*?\"<>|]/g, '').trim();\n  if (!filename) filename = `${key}.bin`;\n\n  // Output separate item with binary data for n8n loop\n  out.push({\n    json: { filename },\n    binary: { file: bin }\n  });\n}\n\nreturn out;\n"
      },
